{
  "name": "compiler-for-js",
  "version": "1.0.0",
  "description": "Zero-G Compiler - Multi-language code compiler and executor with AI assistance",
  "homepage": "https://github.com/swalimnr/zerog-compiler",
  "scripts": {
    "build:client": "node build-client.js",
    "build:server": "tsc",
    "build": "node build-client.js && tsc",
    "watch:client": "node build-client.js --watch",
    "start": "node dist/server.js",
    "dev": "concurrently \"node build-client.js --watch\" \"npx tsc -w\" \"nodemon dist/server.js\""
  },
  "keywords": [],
  "author": "Swalimnr",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@monaco-editor/react": "^4.7.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axios": "^1.13.2",
    "body-parser": "^2.2.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "esbuild": "^0.27.2",
    "express": "^5.2.1",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vm2": "^3.10.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.0.3",
    "concurrently": "^9.2.1",
    "nodemon": "^3.1.11",
    "typescript": "^5.9.3"
  }
}
